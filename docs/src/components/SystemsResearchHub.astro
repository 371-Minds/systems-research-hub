  let currentCognitiveMode: CognitiveMode = "creative";
  let recommendedMode: CognitiveMode | null = null;
  let autoSwitchEnabled = false;
  let dismissedRecommendation: CognitiveMode | null = null;
  let focusDrawerVisible = false;

  const tabDwellSeconds: Record<string, number> = {
    modeler: 0,
    simulator: 0,
    mcp: 0,
    preview: 0,
    frictionless: 0
  };

  let candidateStabilityCount = 0;
  let lastCandidateMode: CognitiveMode | null = null;

  // DOM elements for Cognitive Layer
  const hubWrapper = document.getElementById("systems-research-hub");
  const hubLeftPanel = document.getElementById("hub-left-panel");
  const activeModeBadge = document.getElementById("active-mode-badge");
  const suggestionChip = document.getElementById("cognitive-suggestion-chip");
  const suggestionText = document.getElementById("cognitive-suggestion-text");
  const applySuggestionBtn = document.getElementById("cognitive-apply-suggestion-btn");
  const dismissSuggestionBtn = document.getElementById("cognitive-dismiss-suggestion-btn");
  const autoSwitchInput = document.getElementById("cognitive-auto-switch") as HTMLInputElement;
  const autoSwitchStatus = document.getElementById("auto-switch-status");
  const emphasisIcon = document.getElementById("emphasis-icon");
  const emphasisTitle = document.getElementById("emphasis-title");
  const emphasisDesc = document.getElementById("emphasis-desc");
  const focusDrawerToggleWrap = document.getElementById("focus-drawer-toggle-wrap");
  const toggleIngestionDrawerBtn = document.getElementById("toggle-ingestion-drawer-btn");
  const modeButtons = document.querySelectorAll(".cognitive-mode-btn") as NodeListOf<HTMLButtonElement>;

  function setCognitiveMode(mode: CognitiveMode, userAction: boolean) {
    currentCognitiveMode = mode;
    saveUiPreferences({ cognitiveMode: mode });
    const config = COGNITIVE_MODES[mode];

    if (hubWrapper) {
      hubWrapper.setAttribute("data-cognitive-mode", mode);
      hubWrapper.setAttribute("data-density", config.density);
    }

    modeButtons.forEach((btn) => {
      const btnMode = btn.getAttribute("data-mode");
      const isSelected = btnMode === mode;
      btn.classList.toggle("active", isSelected);
      btn.setAttribute("aria-selected", isSelected ? "true" : "false");
    });

    if (activeModeBadge) {
      activeModeBadge.textContent = `Mode: ${config.name}`;
    }
    if (emphasisIcon) emphasisIcon.textContent = config.icon;
    if (emphasisTitle) emphasisTitle.textContent = `${config.name} Mode Active:`;
    if (emphasisDesc) emphasisDesc.textContent = config.description;

    // Focus mode single-panel immersion vs standard multi-column
    if (mode === "focus") {
      if (focusDrawerToggleWrap) focusDrawerToggleWrap.style.display = "block";
      if (hubLeftPanel) {
        hubLeftPanel.style.display = focusDrawerVisible ? "block" : "none";
      }
    } else {
      if (focusDrawerToggleWrap) focusDrawerToggleWrap.style.display = "none";
      if (hubLeftPanel) {
        hubLeftPanel.style.display = "";
      }
    }

    // Tab emphasis: switch to default tab if user explicitly clicked or auto-switch fired
    if (userAction || autoSwitchEnabled) {
      if (mode !== "focus") {
        switchTab(config.defaultTab);
      }
    }

    // Dismiss active suggestion for this mode if it was suggested
    if (recommendedMode === mode) {
      updateSuggestionChip(null);
    }

    // Re-scale canvases smoothly for updated grid proportions
    setTimeout(() => {
      resizeCanvases();
    }, 60);
  }

  function updateSuggestionChip(mode: CognitiveMode | null) {
    recommendedMode = mode;
    if (!mode || mode === currentCognitiveMode || dismissedRecommendation === mode) {
      if (suggestionChip) suggestionChip.style.display = "none";
      (Object.keys(COGNITIVE_MODES) as CognitiveMode[]).forEach((m) => {
        const badge = document.getElementById(`mode-suggest-badge-${m}`);
        if (badge) badge.style.display = "none";
      });
      return;
    }

    const cfg = COGNITIVE_MODES[mode];
    if (suggestionText) {
      suggestionText.textContent = `${cfg.name} suggested — switch?`;
    }
    if (suggestionChip) {
      suggestionChip.style.display = "flex";
    }

    (Object.keys(COGNITIVE_MODES) as CognitiveMode[]).forEach((m) => {
      const badge = document.getElementById(`mode-suggest-badge-${m}`);
      if (badge) badge.style.display = m === mode ? "inline-block" : "none";
    });
  }

  // Manual Mode Selector Clicks
  modeButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const mode = btn.getAttribute("data-mode") as CognitiveMode;
      if (mode && COGNITIVE_MODES[mode]) {
        setCognitiveMode(mode, true);
      }
    });
