  // Helper to escape HTML safely in dynamic templates
  function escapeHtml(str: string): string {
    return String(str || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  // Toast notifier with status & error details
  function showMcpToast(message: string, type: "success" | "error" | "info" = "success") {
    if (!mcpConnectToast) return;
    mcpConnectToast.style.display = "block";
    mcpConnectToast.className = `mcp-toast mcp-toast-${type}`;
    mcpConnectToast.innerHTML = `
      <div class="toast-content">
        <span class="toast-indicator">${type === "error" ? "✕" : type === "info" ? "ℹ" : "✓"}</span>
        <div class="toast-body">${escapeHtml(message)}</div>
      </div>
    `;

    if (type !== "error") {
      setTimeout(() => {
        if (mcpConnectToast) mcpConnectToast.style.display = "none";
      }, 5000);
    }
  }

  // Live MCP Tool Runner state
  let activeRunnerServerId = "";
  let activeRunnerToolName = "";

  function openToolRunner(serverId: string, toolName: string) {
    const servers = mcpRegistry.getLiveServers();
    const server = servers.find((s) => s.id === serverId);
    const tools = mcpRegistry.getLiveTools();
    const tool = tools.find((t) => t.serverId === serverId && t.name === toolName);

    if (!tool || !server) return;

    activeRunnerServerId = serverId;
    activeRunnerToolName = toolName;

    if (runnerToolName) runnerToolName.textContent = `tools/call: ${tool.name}`;
    if (runnerServerName) runnerServerName.textContent = `Server: ${server.name} (${server.endpointUrl || "local"})`;
    if (runnerToolDesc) runnerToolDesc.textContent = tool.description || "No description provided";

    // Auto-generate template arguments object based on inputSchema
    const defaultArgs: Record<string, any> = {};
    if (tool.inputSchema?.properties) {
      for (const [key, prop] of Object.entries<any>(tool.inputSchema.properties)) {
        if (prop.type === "number") defaultArgs[key] = 100;
        else if (prop.type === "boolean") defaultArgs[key] = true;
        else if (prop.type === "array") defaultArgs[key] = [];
        else if (prop.type === "object") defaultArgs[key] = {};
        else defaultArgs[key] = prop.description ? `${key}_value` : "sample_value";
      }
    }

    if (runnerArgsInput) {
      runnerArgsInput.value = JSON.stringify(defaultArgs, null, 2);
    }

    if (runnerStatusIndicator) {
      runnerStatusIndicator.textContent = "";
      runnerStatusIndicator.className = "runner-status";
    }

    if (runnerResultBox) runnerResultBox.style.display = "none";
    if (runnerResultContent) runnerResultContent.textContent = "";

    if (toolRunnerCard) {
      toolRunnerCard.style.display = "block";
      toolRunnerCard.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }
  }

  closeRunnerBtn?.addEventListener("click", () => {
    if (toolRunnerCard) toolRunnerCard.style.display = "none";
  });

  executeToolCallBtn?.addEventListener("click", async () => {
    if (!activeRunnerServerId || !activeRunnerToolName) return;

    let parsedArgs: Record<string, any> = {};
    const rawArgs = runnerArgsInput?.value.trim() || "{}";
    try {
      parsedArgs = JSON.parse(rawArgs);
    } catch (parseErr: any) {
      if (runnerStatusIndicator) {
        runnerStatusIndicator.className = "runner-status error";
        runnerStatusIndicator.textContent = `Invalid JSON arguments: ${parseErr.message}`;
      }
      return;
    }

    if (runnerStatusIndicator) {
      runnerStatusIndicator.className = "runner-status running";
      runnerStatusIndicator.textContent = `Executing JSON-RPC 2.0 tools/call ("${activeRunnerToolName}")...`;
    }
    executeToolCallBtn.disabled = true;

    try {
      const result = await mcpRegistry.callTool(activeRunnerServerId, activeRunnerToolName, parsedArgs);

      if (runnerStatusIndicator) {
        runnerStatusIndicator.className = "runner-status success";
        runnerStatusIndicator.textContent = `✓ Response received (HTTP 200 OK)`;
      }

      if (runnerResultBox && runnerResultContent) {
        runnerResultBox.style.display = "block";
        runnerResultContent.textContent = JSON.stringify(result, null, 2);
      }
    } catch (callErr: any) {
      // Surface actual HTTP status and response body
      const errMsg = callErr?.message || String(callErr);
      if (runnerStatusIndicator) {
        runnerStatusIndicator.className = "runner-status error";
        runnerStatusIndicator.textContent = `✕ Execution error: ${errMsg}`;
      }
      if (runnerResultBox && runnerResultContent) {
        runnerResultBox.style.display = "block";
        runnerResultContent.textContent = `Error Response:\n${errMsg}`;
      }
    } finally {
      executeToolCallBtn.disabled = false;
    }
  });

