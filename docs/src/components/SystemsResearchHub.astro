      hubLeftPanel.style.display = focusDrawerVisible ? "block" : "none";
    }
    toggleIngestionDrawerBtn.textContent = focusDrawerVisible ? "✕ Hide Ingestion Panel" : "📂 Show Ingestion Panel";
    setTimeout(() => resizeCanvases(), 60);
  });

  // Continuous Behavioral Scoring Loop (CognitiveStateEngine)
  function runCognitiveStateEngine() {
    // 1. Dwell accounting on active tab
    tabDwellSeconds[activeTabName] = (tabDwellSeconds[activeTabName] || 0) + 1;
    unbrokenDwellSeconds++;

    // 2. Slider activity decay
    if (sliderActivityScore > 0) {
      sliderActivityScore = Math.max(sliderActivityScore - 1, 0);
    }

    // 3. Time of day heuristic (circadian strategy vs execution vs analysis curve)
    const hour = new Date().getHours();
    let todExec = 12;
    let todTech = 12;
    let todCreative = 14;
    let todAnalytics = 12;
    let todFocus = 10;

    if (hour >= 6 && hour < 11) {
      // Early morning: Strategy & Planning
      todExec = 28;
      todCreative = 18;
      todAnalytics = 12;
      todTech = 12;
      todFocus = 10;
    } else if (hour >= 11 && hour < 15) {
      // Midday: Deep tech inspection & creative modeling
      todTech = 28;
      todCreative = 22;
      todFocus = 16;
      todAnalytics = 12;
      todExec = 10;
    } else if (hour >= 15 && hour < 19) {
      // Afternoon: Analytics, simulation & testing
      todAnalytics = 28;
      todTech = 18;
      todExec = 14;
      todCreative = 14;
      todFocus = 12;
    } else {
      // Evening/Night: Focus and calm exploratory
      todFocus = 32;
      todCreative = 18;
      todTech = 14;
      todAnalytics = 10;
      todExec = 10;
    }

    // 4. Tab lingering scoring
    const dwellModeler = Math.min((tabDwellSeconds.modeler || 0) * 1.5, 35);
    const dwellSim = Math.min((tabDwellSeconds.simulator || 0) * 1.5, 35);
    const dwellTech = Math.min(((tabDwellSeconds.preview || 0) + (tabDwellSeconds.mcp || 0)) * 1.5, 35);
    const dwellFrictionless = Math.min((tabDwellSeconds.frictionless || 0) * 1.5, 35);
    const unbrokenFocusBonus = unbrokenDwellSeconds > 25 ? Math.min((unbrokenDwellSeconds - 25) * 1.2, 38) : 0;

    // 5. Search vs Inspect ratio scoring
    let searchRatioTech = 0;
    let searchRatioExec = 0;
    let searchRatioCreative = 0;

    const totalActions = searchesCount + inspectsCount;
    if (totalActions > 0) {
      if (inspectsCount > searchesCount * 1.2) {
        // Heavy reading & inspection
        searchRatioTech = Math.min(inspectsCount * 8, 35);
      } else if (searchesCount > inspectsCount * 1.4) {
        // High-level broad scanning
        searchRatioExec = Math.min(searchesCount * 7, 30);
        searchRatioCreative = Math.min(searchesCount * 5, 20);
      } else {
        // Balanced iterative search and inspection
        searchRatioCreative = 16;
        searchRatioTech = 14;
      }
    }

    // 6. Simulator slider activity
    const sliderAnalyticsScore = Math.min(sliderActivityScore, 50);

    // Compute raw scores
    const rawScores: Record<CognitiveMode, number> = {
      executive: todExec + dwellFrictionless + searchRatioExec,
      technical: todTech + dwellTech + searchRatioTech,
      creative: todCreative + dwellModeler + searchRatioCreative,
      analytics: todAnalytics + dwellSim + sliderAnalyticsScore,
      focus: todFocus + unbrokenFocusBonus
    };

    // Normalize scores to percentages (0-100%)
    let maxRaw = Math.max(...Object.values(rawScores));
    if (maxRaw <= 0) maxRaw = 1;

    const normalizedScores: Record<CognitiveMode, number> = {
      executive: Math.min(100, Math.max(14, Math.round((rawScores.executive / maxRaw) * 100))),
      technical: Math.min(100, Math.max(14, Math.round((rawScores.technical / maxRaw) * 100))),
      creative: Math.min(100, Math.max(14, Math.round((rawScores.creative / maxRaw) * 100))),
      analytics: Math.min(100, Math.max(14, Math.round((rawScores.analytics / maxRaw) * 100))),
      focus: Math.min(100, Math.max(14, Math.round((rawScores.focus / maxRaw) * 100)))
    };

    // Update UI score bars
    (Object.keys(COGNITIVE_MODES) as CognitiveMode[]).forEach((m) => {
      const fillBar = document.getElementById(`score-bar-${m}`);
      if (fillBar) {
        fillBar.style.width = `${normalizedScores[m]}%`;
      }
    });

    // Determine top scoring mode
    let topMode: CognitiveMode = currentCognitiveMode;
    let highestScore = -1;
    (Object.keys(COGNITIVE_MODES) as CognitiveMode[]).forEach((m) => {
      if (normalizedScores[m] > highestScore) {
        highestScore = normalizedScores[m];
        topMode = m;
      }
    });

    // Anti-oscillation hysteresis: must lead current mode by at least 8 points
    const currentModeScore = normalizedScores[currentCognitiveMode];
    const qualifiesAsSuggestion = topMode !== currentCognitiveMode && highestScore >= currentModeScore + 8;

    if (qualifiesAsSuggestion) {
      if (topMode === lastCandidateMode) {
        candidateStabilityCount++;
      } else {
        lastCandidateMode = topMode;
        candidateStabilityCount = 0;
      }

      // Once candidate is stable for 2 ticks (2 seconds)
      if (candidateStabilityCount >= 2) {
        if (autoSwitchEnabled) {
          setCognitiveMode(topMode, false);
          updateSuggestionChip(null);
        } else if (dismissedRecommendation !== topMode) {
          updateSuggestionChip(topMode);
        }
      }
    } else {
      candidateStabilityCount = 0;
      if (topMode === currentCognitiveMode && recommendedMode) {
        updateSuggestionChip(null);
      }
    }
  }

  // Start Cognitive Engine ticker (every 1000ms)
  setInterval(runCognitiveStateEngine, 1000);

  // Comprehensive App State Restoration (IndexedDB + localStorage)
  async function restoreAppState() {
    // 1. Restore UI preferences from localStorage
    const prefs = loadUiPreferences();
    if (prefs.searchQuery && searchInput) searchInput.value = prefs.searchQuery;
    if (prefs.typeFilter && typeFilter) typeFilter.value = prefs.typeFilter;
    if (prefs.metasystemLink && metasystemLinkInput) metasystemLinkInput.value = prefs.metasystemLink;
    if (autoSwitchInput) {
      autoSwitchInput.checked = !!prefs.autoSwitchEnabled;
      autoSwitchEnabled = !!prefs.autoSwitchEnabled;
      if (autoSwitchStatus) {
        autoSwitchStatus.textContent = autoSwitchEnabled ? "On (Adaptive)" : "Off (Manual)";
      }
    }
    if (prefs.cognitiveMode && COGNITIVE_MODES[prefs.cognitiveMode]) {
      setCognitiveMode(prefs.cognitiveMode, false);
    }

    // 2. Restore Simulator state from localStorage
    const simState = loadSimulatorState();
    if (sliderAbstraction) {
      sliderAbstraction.value = String(simState.abstraction ?? 85);
      if (valAbstraction) valAbstraction.textContent = `${sliderAbstraction.value}%`;
    }
    if (sliderVelocity) {
      sliderVelocity.value = String(simState.velocity ?? 1.4);
      if (valVelocity) valVelocity.textContent = `${sliderVelocity.value}x`;
    }
    if (sliderFriction) {
      sliderFriction.value = String(simState.friction ?? 70);
      if (valFriction) valFriction.textContent = `${sliderFriction.value}%`;
    }
    isSimulating = simState.isSimulating ?? true;
    if (simPlayPauseBtn) {
      simPlayPauseBtn.textContent = isSimulating ? "⏸ Pause Simulation" : "▶ Resume Simulation";
    }
    simTime = simState.simTime ?? 0;
    simHistory = simState.simHistory || [];
    if (simHistory.length > 0 && simStepCounter) {
      const last = simHistory[simHistory.length - 1];
      simStepCounter.textContent = `T = ${Math.round(simTime)}s | Adoption: ${Math.round(last.adoption)}%`;
    }

    // 3. Restore Cached Drive Files from IndexedDB
    const cachedFiles = await loadFileCache();
    if (cachedFiles && cachedFiles.length > 0) {
      currentFiles = cachedFiles;
      renderFiles(currentFiles);
      mcpRegistry.syncDriveFilesToMcp(currentFiles, "Cached Drive Repositories", "indexeddb-cache");
      if (mcpDriveResourcesCount) {
        mcpDriveResourcesCount.textContent = `${currentFiles.length} synced to MCP`;
      }
      if (driveEmptyUnauth) driveEmptyUnauth.style.display = "none";
    }

    // 4. Restore Drive Accounts from IndexedDB
    const restoredAccounts = await restorePersistedAccounts();
    if (restoredAccounts.length > 0) {
      if (prefs.accountFilter && driveAccountSelector) {
        driveAccountSelector.value = prefs.accountFilter;
      }
    }

    // 5. Restore Inspection History from IndexedDB
    await renderInspectionHistoryUI();

    // 6. Restore Selected File / Document Inspector from IndexedDB
    const lastSelected = await loadLastSelectedFile();
    if (lastSelected && lastSelected.file) {
      selectedFile = lastSelected.file;
      await inspectFile(lastSelected.file, lastSelected.previewText, lastSelected.extractedOntology, false);
    }

    // 7. Finally switch to the user's saved active tab
    if (prefs.activeTab) {
      switchTab(prefs.activeTab);
    }
  }

  // Execute restore on startup
  restoreAppState().catch((err) => {
    console.warn("Error restoring app state from IndexedDB/localStorage:", err);
  });

  /* =========================================================
     STANDALONE 1-CLICK HTML BUNDLE & COMPANION MANIFEST EXPORTER
  ========================================================== */
  async function exportStandaloneBundle(title?: string) {
    const bundleTitle = title?.trim() || "Systems Scientist Research Hub";
    const slug = bundleTitle.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
    const htmlFilename = `frictionless-${slug || "hub"}.html`;
    const manifestFilename = "metasystem-mcp-deploy.json";

    // 1. Gather live accounts and inspection history
    let cachedHistory: any[] = [];
    try {
      cachedHistory = await loadInspectionHistory();
    } catch (_) {}

    const exportOptions: BundleExportOptions = {
      title: bundleTitle,
      accounts: getAllAccounts(),
      activeAccountId: activeAccountsList[0] ? activeAccountsList[0].id : null,
      files: currentFiles,
      selectedFile: selectedFile,
      simulatorState: {
        abstraction: parseFloat(sliderAbstraction?.value || "85"),
        velocity: parseFloat(sliderVelocity?.value || "1.4"),
        friction: parseFloat(sliderFriction?.value || "70"),
        simTime,
        simHistory,
        isSimulating
      },
      uiPreferences: {
        activeTab: activeTabName,
        cognitiveMode: currentCognitiveMode,
        autoSwitchEnabled,
        searchQuery: searchInput?.value || "",
        typeFilter: typeFilter?.value || "all"
      },
      liveMcpServers: mcpRegistry.getLiveServers(),
      mcpServers: mcpRegistry.getServers(),
      inspectionHistory: cachedHistory
    };

    // 2. Collect rendered stylesheets from the DOM
    const extraCss = collectDocumentStyles();

    // 3. Generate companion deployment manifest data
    const manifestData = generateDeploymentManifest(bundleTitle, htmlFilename, exportOptions);

    // 4. Generate the full, self-contained standalone HTML file
    const htmlContent = generateStandaloneBundleHtml(bundleTitle, exportOptions, undefined, extraCss);

    // 5. Trigger download of the single self-contained HTML file
    triggerFileDownload(htmlContent, htmlFilename, "text/html;charset=utf-8");

    // 6. Trigger download of the companion manifest JSON inside the SAME download action
    setTimeout(() => {
      const manifestJson = JSON.stringify(manifestData, null, 2);
      triggerFileDownload(manifestJson, manifestFilename, "application/json;charset=utf-8");
    }, 200);

    // 7. Surface visual feedback in the research hub
    showMcpToast(
      `📦 Exported standalone HTML bundle "${htmlFilename}" and companion manifest "${manifestFilename}"! Self-contained, working against connected Drive on load.`,
      "success"
    );
  }

  // Wire Tab 5 buttons
  exportStandaloneBtn?.addEventListener("click", () => {
    exportStandaloneBundle("Systems Scientist Research Hub");
  });

  downloadManifestBtn?.addEventListener("click", () => {
    exportStandaloneBundle("Systems Scientist Research Hub");
  });

  // Wire all existing export buttons
  document.querySelectorAll(".export-bundle-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const title = metasystemLinkInput?.value.trim() || (selectedFile ? selectedFile.name : "Active Research Repo");
      exportStandaloneBundle(title);
    });
  });

  // Expose globally on window for programmatic access or testing
  (window as any).exportStandaloneBundle = exportStandaloneBundle;

  resizeCanvases();
  requestAnimationFrame(simLoop);
</script>

