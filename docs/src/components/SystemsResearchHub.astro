    saveUiPreferences({ autoSwitchEnabled });
    if (autoSwitchStatus) {
      autoSwitchStatus.textContent = autoSwitchEnabled ? "On (Adaptive)" : "Off (Manual)";
    }
    if (autoSwitchEnabled && recommendedMode && recommendedMode !== currentCognitiveMode) {
      setCognitiveMode(recommendedMode, false);
