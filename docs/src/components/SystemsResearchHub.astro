<script>
  import {
    initAuth,
    connectNewGoogleDrive,
    disconnectAccount,
    disconnectAll,
    getAllAccounts,
    setActiveAccount,
    subscribeAccounts,
    restorePersistedAccounts,
    type ConnectedDriveAccount
  } from "../lib/driveAuth";
  import { listDriveFiles, fetchFileContentPreview, type DriveFile } from "../lib/driveApi";
  import { mcpRegistry } from "../lib/mcpRegistry";
  import {
    saveFileCache,
    loadFileCache,
    saveInspectedFile,
    loadInspectionHistory,
    loadLastSelectedFile,
    saveUiPreferences,
    loadUiPreferences,
    saveSimulatorState,
    loadSimulatorState,
    wipeAllLocalPersistence
  } from "../lib/persistence";
  import {
    generateStandaloneBundleHtml,
    generateDeploymentManifest,
    collectDocumentStyles,
    triggerFileDownload,
    type BundleExportOptions
  } from "../lib/standaloneBundleExporter";

  let currentFiles: DriveFile[] = [];
  let selectedFile: DriveFile | null = null;
  let activeAccountsList: ConnectedDriveAccount[] = [];

  // DOM Elements
  const addDriveBtn = document.getElementById("add-google-drive-btn");
  const wipeEverythingBtn = document.getElementById("wipe-everything-btn");
  const accountsChipList = document.getElementById("accounts-chip-list");
  const authStatusChip = document.getElementById("auth-status-chip");
  const driveAccountSelector = document.getElementById("drive-account-selector") as HTMLSelectElement;

  const driveLoading = document.getElementById("drive-loading-state");
  const driveEmptyUnauth = document.getElementById("drive-empty-unauth");
  const driveEmptySearch = document.getElementById("drive-empty-search");
  const driveFilesList = document.getElementById("drive-files-list");
  const filesCountBadge = document.getElementById("files-count-badge");
  const searchInput = document.getElementById("drive-search-input") as HTMLInputElement;
  const typeFilter = document.getElementById("drive-type-filter") as HTMLSelectElement;

  const tabModeler = document.getElementById("tab-modeler");
  const tabSimulator = document.getElementById("tab-simulator");
  const tabMcp = document.getElementById("tab-mcp");
  const tabPreview = document.getElementById("tab-preview");
  const tabFrictionless = document.getElementById("tab-frictionless");

  const viewModeler = document.getElementById("view-modeler");
  const viewSimulator = document.getElementById("view-simulator");
  const viewMcp = document.getElementById("view-mcp");
  const viewPreview = document.getElementById("view-preview");
  const viewFrictionless = document.getElementById("view-frictionless");
  const docPreviewContainer = document.getElementById("doc-preview-container");
  const inspectionHistoryPanel = document.getElementById("inspection-history-panel");
  const inspectionHistoryList = document.getElementById("inspection-history-list");
  const historyCountBadge = document.getElementById("history-count-badge");

  const metasystemLinkInput = document.getElementById("metasystem-link-input") as HTMLInputElement;
  const synthesizeBtn = document.getElementById("synthesize-btn");
  const synthesizerOutput = document.getElementById("synthesizer-output");
  const downloadManifestBtn = document.getElementById("download-full-manifest-btn");
  const exportStandaloneBtn = document.getElementById("export-standalone-hub-btn");
  const mcpDriveResourcesCount = document.getElementById("mcp-drive-resources-count");

  const customMcpUrl = document.getElementById("custom-mcp-url") as HTMLInputElement;
  const addCustomMcpBtn = document.getElementById("add-custom-mcp-btn") as HTMLButtonElement;
  const mcpConnectToast = document.getElementById("mcp-connect-toast");
  const liveServersList = document.getElementById("live-mcp-servers-list");
  const liveServersCountBadge = document.getElementById("live-servers-count-badge");
  const toolRunnerCard = document.getElementById("mcp-tool-runner-card");
  const runnerToolName = document.getElementById("runner-tool-name");
  const runnerServerName = document.getElementById("runner-server-name");
  const runnerToolDesc = document.getElementById("runner-tool-desc");
  const runnerArgsInput = document.getElementById("runner-args-input") as HTMLTextAreaElement;
  const executeToolCallBtn = document.getElementById("execute-tool-call-btn") as HTMLButtonElement;
  const runnerStatusIndicator = document.getElementById("runner-status-indicator");
  const runnerResultBox = document.getElementById("runner-result-box");
  const runnerResultContent = document.getElementById("runner-result-content");
  const closeRunnerBtn = document.getElementById("close-runner-btn");

  // Tab switching
  let activeTabName: "modeler" | "simulator" | "mcp" | "preview" | "frictionless" = "modeler";
  let unbrokenDwellSeconds = 0;

  function switchTab(target: "modeler" | "simulator" | "mcp" | "preview" | "frictionless") {
    activeTabName = target;
    unbrokenDwellSeconds = 0;
    saveUiPreferences({ activeTab: target });

    [tabModeler, tabSimulator, tabMcp, tabPreview, tabFrictionless].forEach((btn) => btn?.classList.remove("active"));
    [viewModeler, viewSimulator, viewMcp, viewPreview, viewFrictionless].forEach((el) => {
      if (el) el.style.display = "none";
    });

    if (target === "modeler") {
      tabModeler?.classList.add("active");
      if (viewModeler) viewModeler.style.display = "block";
    } else if (target === "simulator") {
      tabSimulator?.classList.add("active");
      if (viewSimulator) {
        viewSimulator.style.display = "block";
        resizeCanvases();
      }
    } else if (target === "mcp") {
      tabMcp?.classList.add("active");
      if (viewMcp) {
        viewMcp.style.display = "block";
        renderLiveMcpServers();
      }
    } else if (target === "preview") {
      tabPreview?.classList.add("active");
      if (viewPreview) viewPreview.style.display = "block";
    } else if (target === "frictionless") {
      tabFrictionless?.classList.add("active");
      if (viewFrictionless) viewFrictionless.style.display = "block";
    }
  }

  tabModeler?.addEventListener("click", () => switchTab("modeler"));
  tabSimulator?.addEventListener("click", () => switchTab("simulator"));
  tabMcp?.addEventListener("click", () => switchTab("mcp"));
  tabPreview?.addEventListener("click", () => switchTab("preview"));
  tabFrictionless?.addEventListener("click", () => switchTab("frictionless"));

  // Multi-Drive Accounts Management UI
  subscribeAccounts((accounts, activeId) => {
    activeAccountsList = accounts;
    renderAccountsChips(accounts, activeId);
    updateAccountSelector(accounts, activeId);

    if (accounts.length > 0) {
      if (authStatusChip) {
        authStatusChip.textContent = `${accounts.length} Drive${accounts.length > 1 ? "s" : ""} Connected`;
        authStatusChip.className = "hub-chip status-connected";
      }
      if (driveEmptyUnauth) driveEmptyUnauth.style.display = "none";
      loadFederatedDriveData();
    } else {
      if (authStatusChip) {
        authStatusChip.textContent = "0 Drives Connected";
        authStatusChip.className = "hub-chip status-idle";
      }
      if (currentFiles.length === 0) {
        if (driveEmptyUnauth) driveEmptyUnauth.style.display = "flex";
        if (driveFilesList) driveFilesList.style.display = "none";
        if (filesCountBadge) filesCountBadge.textContent = "0 items";
      }
    }
  });

  // Sign out & Wipe Everything (IndexedDB, localStorage, tokens, cache, history)
  wipeEverythingBtn?.addEventListener("click", async () => {
    const confirmed = confirm(
      "Are you sure you want to sign out and wipe all local data?\n\nThis will permanently delete all stored Google Drive tokens, cached research files, document inspection history, and simulator configurations from this browser. No traces will remain."
    );
    if (!confirmed) return;

    try {
      wipeEverythingBtn.setAttribute("disabled", "true");
      await wipeAllLocalPersistence();
      await disconnectAll();

      currentFiles = [];
      selectedFile = null;
      simTime = 0;
      simHistory = [];
      particles = [];

      if (searchInput) searchInput.value = "";
      if (typeFilter) typeFilter.value = "all";
      if (metasystemLinkInput) metasystemLinkInput.value = "";
      if (filesCountBadge) filesCountBadge.textContent = "0 items";
      if (driveFilesList) {
        driveFilesList.innerHTML = "";
        driveFilesList.style.display = "none";
      }
      if (driveEmptyUnauth) driveEmptyUnauth.style.display = "flex";
      if (driveEmptySearch) driveEmptySearch.style.display = "none";
      if (docPreviewContainer) {
        docPreviewContainer.innerHTML = `
          <div class="preview-empty">
            <span class="preview-icon">📄</span>
            <h4>Select a Document to Inspect</h4>
            <p>Click "Inspect" on any document in your Google Drive list to load full preview and systemic extracted concepts.</p>
          </div>
        `;
      }
      if (inspectionHistoryPanel) inspectionHistoryPanel.style.display = "none";
      if (historyCountBadge) historyCountBadge.textContent = "0 cached";

      if (sliderAbstraction) sliderAbstraction.value = "85";
      if (valAbstraction) valAbstraction.textContent = "85%";
      if (sliderVelocity) sliderVelocity.value = "1.4";
      if (valVelocity) valVelocity.textContent = "1.4x";
      if (sliderFriction) sliderFriction.value = "70";
      if (valFriction) valFriction.textContent = "70%";
      isSimulating = true;
      if (simPlayPauseBtn) simPlayPauseBtn.textContent = "⏸ Pause Simulation";
      if (metricsCanvas) {
        const metricsCtx = metricsCanvas.getContext("2d");
        if (metricsCtx) metricsCtx.clearRect(0, 0, metricsCanvas.width, metricsCanvas.height);
      }

      setCognitiveMode("creative", true);
      switchTab("modeler");

      showMcpToast("✓ Successfully signed out and wiped all local tokens, file caches, history, and preferences.", "info");
    } catch (err: any) {
      showMcpToast(`✕ Error wiping local data: ${err.message}`, "error");
    } finally {
      wipeEverythingBtn.removeAttribute("disabled");
    }
  });

  // Render Inspection History (IndexedDB Cached)
  async function renderInspectionHistoryUI() {
    if (!inspectionHistoryPanel || !inspectionHistoryList) return;
    const history = await loadInspectionHistory();
    if (historyCountBadge) {
      historyCountBadge.textContent = `${history.length} cached`;
    }
    if (history.length === 0) {
      inspectionHistoryPanel.style.display = "none";
      return;
    }
    inspectionHistoryPanel.style.display = "block";
    inspectionHistoryList.innerHTML = "";
    history.slice(0, 10).forEach((item) => {
      const chip = document.createElement("button");
      chip.type = "button";
      chip.className = `history-chip ${selectedFile?.id === item.file.id ? "active" : ""}`;
      const dateStr = new Date(item.inspectedAt).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
      chip.innerHTML = `
        <span class="chip-icon">${getFileIcon(item.file.mimeType)}</span>
        <span class="chip-name" title="${escapeHtml(item.file.name)}">${escapeHtml(item.file.name)}</span>
        <span class="chip-time">${dateStr}</span>
      `;
      chip.addEventListener("click", () => {
        inspectFile(item.file, item.previewText, item.extractedOntology, true);
      });
      inspectionHistoryList.appendChild(chip);
    });
  }

  function renderAccountsChips(accounts: ConnectedDriveAccount[], activeId: string | null) {
    if (!accountsChipList) return;
    if (accounts.length === 0) {
      accountsChipList.innerHTML = `
        <div class="empty-accounts-prompt">
          No Google Drives connected yet. Click <strong>+ Connect Another Google Drive</strong> to authenticate the first repository with secure client-side in-memory tokens.
        </div>
      `;
      return;
    }

    accountsChipList.innerHTML = "";
    accounts.forEach((acc) => {
      const chip = document.createElement("div");
      chip.className = `account-pill ${acc.id === activeId ? "active" : ""}`;
      chip.innerHTML = `
        <img class="pill-avatar" src="${acc.photoURL || "https://api.dicebear.com/7.x/identicon/svg?seed=" + encodeURIComponent(acc.email)}" alt="" />
        <div class="pill-meta">
          <strong class="pill-name">${acc.label || acc.displayName}</strong>
          <span class="pill-email">${acc.email}</span>
        </div>
        <button class="pill-remove-btn" title="Disconnect ${acc.email}" data-id="${acc.id}">×</button>
      `;

      chip.addEventListener("click", (e) => {
        if ((e.target as HTMLElement).classList.contains("pill-remove-btn")) return;
        setActiveAccount(acc.id);
      });

      chip.querySelector(".pill-remove-btn")?.addEventListener("click", async (e) => {
        e.stopPropagation();
        await disconnectAccount(acc.id);
      });

      accountsChipList.appendChild(chip);
    });
  }

  function updateAccountSelector(accounts: ConnectedDriveAccount[], activeId: string | null) {
    if (!driveAccountSelector) return;
    driveAccountSelector.innerHTML = `<option value="all">All Connected Drives (${accounts.length})</option>`;
    accounts.forEach((acc) => {
      const opt = document.createElement("option");
      opt.value = acc.id;
      opt.textContent = `${acc.label || acc.displayName} (${acc.email})`;
      if (acc.id === activeId) opt.selected = true;
      driveAccountSelector.appendChild(opt);
    });
  }

  driveAccountSelector?.addEventListener("change", () => {
    loadFederatedDriveData();
  });

  addDriveBtn?.addEventListener("click", async () => {
    try {
      addDriveBtn.setAttribute("disabled", "true");
      const defaultLabel = prompt("Enter a label for this Google Drive (e.g. 'Personal Lab', 'Enterprise Research'):", `Drive #${activeAccountsList.length + 1}`) || undefined;
      await connectNewGoogleDrive(defaultLabel);
    } catch (e: any) {
      alert(`Could not complete Google Drive sign-in: ${e.message}`);
    } finally {
      addDriveBtn.removeAttribute("disabled");
    }
  });

  // Federated Multi-Drive Ingestion
  async function loadFederatedDriveData() {
    const accounts = getAllAccounts();
    if (accounts.length === 0) return;

    if (driveLoading) driveLoading.style.display = "flex";
    if (driveEmptyUnauth) driveEmptyUnauth.style.display = "none";
    if (driveEmptySearch) driveEmptySearch.style.display = "none";
    if (driveFilesList) driveFilesList.style.display = "none";

    try {
      const filterVal = (typeFilter?.value as any) || "all";
      const queryVal = searchInput?.value || "";
      const selectedScope = driveAccountSelector?.value || "all";

      let targetAccounts = accounts;
      if (selectedScope !== "all") {
        targetAccounts = accounts.filter((a) => a.id === selectedScope);
      }

      // Query all target drives in parallel
      const filePromises = targetAccounts.map(async (acc) => {
        try {
          const res = await listDriveFiles(
            acc.accessToken,
            { query: queryVal, mimeTypeFilter: filterVal },
            { email: acc.email, label: acc.label || acc.displayName }
          );
          // Register files directly into the Model Context Protocol (MCP) registry!
          mcpRegistry.syncDriveFilesToMcp(res.files, acc.label || acc.displayName, acc.id);
          return res.files;
        } catch (err) {
          console.error(`Error querying drive for ${acc.email}:`, err);
          return [];
        }
      });

      const results = await Promise.all(filePromises);
      currentFiles = results.flat();

      if (currentFiles.length > 0) {
        await saveFileCache(currentFiles);
      }

      saveUiPreferences({
        searchQuery: queryVal,
        typeFilter: filterVal,
        accountFilter: selectedScope
      });

      if (mcpDriveResourcesCount) {
        mcpDriveResourcesCount.textContent = `${currentFiles.length} synced to MCP`;
      }

      renderFiles(currentFiles);
    } catch (err: any) {
      console.error("Failed to list Google Drive files:", err);
      if (driveFilesList) {
        driveFilesList.innerHTML = `<li class="error-item">⚠️ Unable to load Google Drive files: ${err.message}</li>`;
        driveFilesList.style.display = "block";
      }
    } finally {
      if (driveLoading) driveLoading.style.display = "none";
    }
  }

  function renderFiles(files: DriveFile[]) {
    if (filesCountBadge) filesCountBadge.textContent = `${files.length} items`;

    if (!files.length) {
      if (driveEmptySearch) driveEmptySearch.style.display = "flex";
      if (driveFilesList) driveFilesList.style.display = "none";
      return;
    }

