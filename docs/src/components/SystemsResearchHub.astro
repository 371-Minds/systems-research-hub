    recordSliderInteraction();
    saveSimulatorState({ friction: parseFloat(sliderFriction.value) });
  });

  interface CausalNode {
    id: string;
    label: string;
    x: number;
    y: number;
    radius: number;
    color: string;
  }

  interface CausalEdge {
    from: string;
    to: string;
    polarity: "+" | "-";
    label: string;
  }

  const nodes: CausalNode[] = [
    { id: "ingestion", label: "Multi-Drive Ingestion", x: 90, y: 70, radius: 36, color: "#6366f1" },
    { id: "ontology", label: "MCP Context Router", x: 280, y: 55, radius: 34, color: "#a855f7" },
    { id: "abstraction", label: "Zero-Friction UI", x: 470, y: 75, radius: 36, color: "#06b6d4" },
    { id: "adoption", label: "Non-Tech Adoption", x: 460, y: 200, radius: 38, color: "#22c55e" },
    { id: "friction", label: "Cognitive Load", x: 280, y: 195, radius: 34, color: "#ef4444" },
    { id: "feedback", label: "Systemic Telemetry", x: 90, y: 200, radius: 34, color: "#f59e0b" },
  ];

  const edges: CausalEdge[] = [
    { from: "ingestion", to: "ontology", polarity: "+", label: "Structures" },
    { from: "ontology", to: "abstraction", polarity: "+", label: "Informs" },
    { from: "abstraction", to: "friction", polarity: "-", label: "Damps" },
    { from: "friction", to: "adoption", polarity: "-", label: "Inhibits" },
    { from: "abstraction", to: "adoption", polarity: "+", label: "Accelerates" },
    { from: "adoption", to: "feedback", polarity: "+", label: "Generates" },
    { from: "feedback", to: "ingestion", polarity: "+", label: "Reinforces (R1)" },
  ];

  interface Particle {
    fromNode: CausalNode;
    toNode: CausalNode;
    progress: number;
    speed: number;
  }

  let particles: Particle[] = [];
  let isSimulating = true;
  let simTime = 0;

  interface HistoryPoint {
    time: number;
    adoption: number;
    coherence: number;
    friction: number;
  }

  let simHistory: HistoryPoint[] = [];

  function resizeCanvases() {
    if (!causalCanvas || !metricsCanvas) return;
    const parentWidth = causalCanvas.parentElement?.clientWidth || 600;
    causalCanvas.width = Math.max(parentWidth, 320);
    causalCanvas.height = 270;
    metricsCanvas.width = Math.max(parentWidth, 320);
    metricsCanvas.height = 110;

    // Rescale node coordinates relative to width
    const w = causalCanvas.width;
    nodes[0]!.x = w * 0.16;
    nodes[0]!.y = 70;
    nodes[1]!.x = w * 0.50;
    nodes[1]!.y = 55;
    nodes[2]!.x = w * 0.84;
    nodes[2]!.y = 70;
    nodes[3]!.x = w * 0.84;
    nodes[3]!.y = 205;
    nodes[4]!.x = w * 0.50;
    nodes[4]!.y = 200;
    nodes[5]!.x = w * 0.16;
    nodes[5]!.y = 205;
  }

  window.addEventListener("resize", resizeCanvases);

  function spawnParticles() {
    if (particles.length > 20) return;
    edges.forEach((edge) => {
      if (Math.random() < 0.25) {
        const fromNode = nodes.find((n) => n.id === edge.from);
        const toNode = nodes.find((n) => n.id === edge.to);
        if (fromNode && toNode) {
          particles.push({
            fromNode,
            toNode,
            progress: 0,
            speed: 0.012 * (parseFloat(sliderVelocity?.value || "1.4")),
          });
        }
      }
    });
  }

  function drawCausalDiagram(ctx: CanvasRenderingContext2D) {
    ctx.clearRect(0, 0, causalCanvas.width, causalCanvas.height);

    // Draw Edges
    edges.forEach((edge) => {
      const fromNode = nodes.find((n) => n.id === edge.from);
      const toNode = nodes.find((n) => n.id === edge.to);
      if (!fromNode || !toNode) return;

      ctx.beginPath();
      ctx.moveTo(fromNode.x, fromNode.y);
      ctx.lineTo(toNode.x, toNode.y);
      ctx.strokeStyle = edge.polarity === "+" ? "rgba(34, 197, 94, 0.45)" : "rgba(56, 189, 248, 0.45)";
      ctx.lineWidth = 2;
      ctx.stroke();

      // Polarity symbol
      const midX = (fromNode.x + toNode.x) / 2;
      const midY = (fromNode.y + toNode.y) / 2;
      ctx.fillStyle = edge.polarity === "+" ? "#4ade80" : "#38bdf8";
      ctx.font = "bold 13px sans-serif";
      ctx.fillText(`(${edge.polarity})`, midX - 6, midY - 6);
    });

    // Draw Particles
    particles.forEach((p, idx) => {
      p.progress += p.speed;
      const curX = p.fromNode.x + (p.toNode.x - p.fromNode.x) * p.progress;
      const curY = p.fromNode.y + (p.toNode.y - p.fromNode.y) * p.progress;

      ctx.beginPath();
      ctx.arc(curX, curY, 4, 0, Math.PI * 2);
      ctx.fillStyle = "#fbbf24";
      ctx.shadowColor = "#fbbf24";
      ctx.shadowBlur = 8;
      ctx.fill();
      ctx.shadowBlur = 0;

      if (p.progress >= 1) {
        particles.splice(idx, 1);
      }
    });

    // Draw Nodes
    nodes.forEach((node) => {
      ctx.beginPath();
      ctx.arc(node.x, node.y, node.radius, 0, Math.PI * 2);
      ctx.fillStyle = "rgba(15, 23, 42, 0.9)";
      ctx.fill();
      ctx.lineWidth = 2.5;
      ctx.strokeStyle = node.color;
      ctx.stroke();

      ctx.fillStyle = "#f8fafc";
      ctx.font = "bold 10px sans-serif";
      ctx.textAlign = "center";
      ctx.textBaseline = "middle";

      const words = node.label.split(" ");
      if (words.length === 2) {
        ctx.fillText(words[0]!, node.x, node.y - 6);
        ctx.fillText(words[1]!, node.x, node.y + 7);
      } else {
        ctx.fillText(node.label, node.x, node.y);
      }
    });
  }

  let simSaveTicker = 0;
  function stepSimulation() {
    simTime += 0.1;
    const abstraction = parseFloat(sliderAbstraction?.value || "85") / 100;
    const velocity = parseFloat(sliderVelocity?.value || "1.4");
    const frictionFactor = parseFloat(sliderFriction?.value || "70") / 100;

    // Cybernetic Euler integration step
    const friction = Math.max(5, 100 * (1 - abstraction) * (1 - frictionFactor * 0.5) + Math.sin(simTime * 0.4) * 3);
    const adoption = Math.min(99, 30 + (70 * abstraction) * (1 - Math.exp(-simTime * 0.1 * velocity)) - (friction * 0.15));
    const coherence = Math.min(98, 50 + 45 * (1 - Math.exp(-simTime * 0.08 * velocity)) + Math.cos(simTime * 0.2) * 2);

    simHistory.push({
      time: Math.round(simTime),
      adoption,
      coherence,
      friction,
    });

    if (simHistory.length > 50) {
      simHistory.shift();
    }

    if (simStepCounter) {
      simStepCounter.textContent = `T = ${Math.round(simTime)}s | Adoption: ${Math.round(adoption)}%`;
    }

    simSaveTicker++;
    if (simSaveTicker % 20 === 0) {
      saveSimulatorState({
        simTime,
        simHistory,
        isSimulating
      });
    }
  }

  function drawMetricsChart(ctx: CanvasRenderingContext2D) {
    ctx.clearRect(0, 0, metricsCanvas.width, metricsCanvas.height);
    const w = metricsCanvas.width;
    const h = metricsCanvas.height;

    // Background grid lines
    ctx.strokeStyle = "rgba(148, 163, 184, 0.1)";
    ctx.lineWidth = 1;
    for (let y = 20; y < h; y += 30) {
      ctx.beginPath();
      ctx.moveTo(0, y);
      ctx.lineTo(w, y);
      ctx.stroke();
    }

    if (simHistory.length < 2) return;

    const plotSeries = (prop: "adoption" | "coherence" | "friction", color: string) => {
      ctx.beginPath();
      simHistory.forEach((pt, i) => {
        const x = (i / (simHistory.length - 1)) * w;
        const y = h - (pt[prop] / 100) * (h - 15) - 6;
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      });
      ctx.strokeStyle = color;
      ctx.lineWidth = 2;
      ctx.stroke();
    };

    plotSeries("adoption", "#22c55e");
    plotSeries("coherence", "#38bdf8");
    plotSeries("friction", "#ef4444");
  }

  function simLoop() {
    if (causalCanvas && metricsCanvas) {
      const causalCtx = causalCanvas.getContext("2d");
      const metricsCtx = metricsCanvas.getContext("2d");

      if (causalCtx) {
        if (isSimulating) spawnParticles();
        drawCausalDiagram(causalCtx);
      }

      if (metricsCtx && isSimulating) {
        stepSimulation();
        drawMetricsChart(metricsCtx);
      }
    }

    requestAnimationFrame(simLoop);
  }

  simPlayPauseBtn?.addEventListener("click", () => {
    recordSliderInteraction();
    isSimulating = !isSimulating;
    if (simPlayPauseBtn) {
      simPlayPauseBtn.textContent = isSimulating ? "⏸ Pause Simulation" : "▶ Resume Simulation";
    }
    saveSimulatorState({ isSimulating, simTime, simHistory });
  });

  simResetBtn?.addEventListener("click", () => {
    recordSliderInteraction();
    simTime = 0;
    simHistory = [];
    particles = [];
    if (metricsCanvas) {
      const metricsCtx = metricsCanvas.getContext("2d");
      if (metricsCtx) metricsCtx.clearRect(0, 0, metricsCanvas.width, metricsCanvas.height);
    }
    saveSimulatorState({ simTime: 0, simHistory: [] });
  });

  /* =========================================================
     ADAPTIVE COGNITIVE UI LAYER & COGNITIVE STATE ENGINE
  ========================================================== */
